  "copyFailed": { "message": "复制失败" },
  "saveFailed": { "message": "保存失败" },
  "translationFailed": {
    "message": "翻译失败"
  },
  "errorApiKeyMissing": {
    "message": "$TRANSLATOR$：请在 HoverTranslate 设置中添加 API 密钥",
