{
  "name": { "message": "HoverTranslate - YouTube 字幕翻译器" },
  "description": { "message": "鼠标悬停在 YouTube 字幕的单词上即可看到翻译，看视频学英语、积累生词。一键存入生词本，可导出 CSV。免费，无需注册。" },
  "translationSaved": { "message": "翻译已保存" },
